
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

data = {
    'CustomerID': range(1, 11),
    'Age': [25, 30, 45, np.nan, 35, 50, 28, 40, np.nan, 32],
    'MonthlyCharges': [500, 700, 800, 600, np.nan, 900, 450, 750, 650, 550],
    'Tenure': [2, 12, 24, 6, 36, 48, 3, 18, 10, 30],
    'Contract': ['Monthly', 'Yearly', 'Monthly', 'Monthly',
                 'Yearly', 'Yearly', 'Monthly', 'Yearly',
                 'Monthly', 'Yearly'],
    'Churn': ['Yes', 'No', 'Yes', 'Yes', 'No',
              'No', 'Yes', 'No', 'Yes', 'No']
}

df = pd.DataFrame(data)

print("Original Dataset:")
print(df)

df = df.drop_duplicates()

df['Age'] = df['Age'].fillna(df['Age'].median())
df['MonthlyCharges'] = df['MonthlyCharges'].fillna(
    df['MonthlyCharges'].median()
)

print("\nCleaned Dataset:")
print(df)

print("\nSummary Statistics:")
print(df.describe())

print("\nChurn Count:")
print(df['Churn'].value_counts())

print("\nAverage Monthly Charges by Churn:")
print(df.groupby('Churn')['MonthlyCharges'].mean())

print("\nAverage Tenure by Churn:")
print(df.groupby('Churn')['Tenure'].mean())

plt.figure(figsize=(10, 8))

plt.subplot(2, 2, 1)
df['Churn'].value_counts().plot(kind='bar')
plt.title("Customer Churn Count")
plt.xlabel("Churn")
plt.ylabel("Number of Customers")

plt.subplot(2, 2, 2)
plt.hist(df['Age'], bins=5)
plt.title("Age Distribution")
plt.xlabel("Age")
plt.ylabel("Frequency")

plt.subplot(2, 2, 3)
df.boxplot(column='MonthlyCharges', by='Churn')
plt.title("Monthly Charges by Churn")
plt.suptitle("")
plt.xlabel("Churn")
plt.ylabel("Monthly Charges")

plt.subplot(2, 2, 4)
pd.crosstab(df['Contract'], df['Churn']).plot(
    kind='bar', ax=plt.gca()
)
plt.title("Contract Type vs Churn")
plt.xlabel("Contract")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()

df.to_csv("cleaned_churn.csv", index=False)

print("\nCleaned dataset saved successfully!")
