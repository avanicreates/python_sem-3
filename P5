class WeatherStation:
    def __init__(self):
        self.displays = []

    def register(self, display):
        self.displays.append(display)

    def set_temperature(self, temperature):
        print("\nTemperature changed to", temperature, "°C")
        for display in self.displays:
            display.update(temperature)


class Display:
    def __init__(self, name):
        self.name = name

    def update(self, temperature):
        print(self.name, "display:", temperature, "°C")


station = WeatherStation()

d1 = Display("Display 1")
d2 = Display("Display 2")

station.register(d1)
station.register(d2)

station.set_temperature(30)
station.set_temperature(35)
