class Apple:
    def display(self):
        print("Fruit: Apple")


class Mango:
    def display(self):
        print("Fruit: Mango")


class Orange:
    def display(self):
        print("Fruit: Orange")


class FruitFactory:
    @staticmethod
    def create_fruit(name):
        if name == "apple":
            return Apple()
        elif name == "mango":
            return Mango()
        elif name == "orange":
            return Orange()
        else:
            return None


fruit = FruitFactory.create_fruit(input("Enter fruit: ").lower())

if fruit:
    fruit.display()
else:
    print("Invalid fruit")


