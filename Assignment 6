def knapsack_bottom_up(w, v, W):
    n = len(w)
    dp = [[0] * (W + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for j in range(W + 1):
            if w[i - 1] <= j:
                dp[i][j] = max(dp[i - 1][j],
                                v[i - 1] + dp[i - 1][j - w[i - 1]])
            else:
                dp[i][j] = dp[i - 1][j]

    return dp[n][W]

def knapsack_top_down(w, v, W, n, memo={}):
    if n == 0 or W == 0:
        return 0

    if (n, W) in memo:
        return memo[(n, W)]

    if w[n - 1] <= W:
        memo[(n, W)] = max(
            v[n - 1] + knapsack_top_down(w, v, W - w[n - 1], n - 1, memo),
            knapsack_top_down(w, v, W, n - 1, memo)
        )
    else:
        memo[(n, W)] = knapsack_top_down(w, v, W, n - 1, memo)

    return memo[(n, W)]

weights = [2, 3, 4, 5]
values = [3, 4, 5, 6]
capacity = 5

print("Bottom-Up:", knapsack_bottom_up(weights, values, capacity))
print("Top-Down:", knapsack_top_down(weights, values, capacity, len(weights)))
